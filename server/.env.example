# Copy this file to .env and fill in real values. Never commit .env to Git.

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=ielts_app
DB_PASSWORD=dev_password_change_me
DB_NAME=ielts_prep

# Auth
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# AI (optional in development - the writing evaluator falls back to a
# clearly-labelled mock evaluation when this is missing)
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Resend for Email Verification
RESEND_API_KEY=
