{
  "name": "ielts-prep-server",
  "version": "1.0.0",
  "description": "REST API for the AI-powered IELTS Preparation Platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node scripts/run-prod-fixes.js && node server.js",
    "dev": "node --watch server.js",
    "db:reset": "node scripts/run-seeds.js",
    "db:fix-vocab": "node scripts/fix-vocab-mojibake.js",
    "admin": "node scripts/manage-admin.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "lint": "cd .. && eslint -c server/eslint.config.js server client add-favicon.js fix.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.112.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  }
}
